{
  "root": true,
  "extends": [
    "plugin:@mattermost/react",

    // Not part of the shared config, which supplies the jest env and globals but no
    // jest rules. Kept for `jest/no-focused-tests`: a stray `it.only` silently skips
    // the rest of a suite while CI stays green.
    "plugin:jest/recommended"
  ],
  "settings": {
    // `@/*` maps to `src/*` and `mattermost-redux/*` is served by the package's
    // own exports map; the TypeScript resolver follows both.
    "import/resolver": {
      "typescript": {
        "project": "./"
      }
    }
  },
  "rules": {
    // Mandates Mattermost's own `components/external_link`, which this plugin does not have.
    "@mattermost/use-external-link": 0,

    // The shared config requires a Mattermost, Inc. copyright header. Matterpoll is
    // community-maintained and carries no per-file header.
    "header/header": 0,

    // The shared config leaves this to tsc. Keep it on: tsconfig only includes
    // `src` and `tests`, so nothing else type-checks the root-level configs.
    "import/no-unresolved": 2
  }
}
